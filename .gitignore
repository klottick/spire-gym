# Isolated implementation checkouts.
.worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Compiled extension artifacts (build in place with `maturin develop`).
python/*/*.so

# Rust build output.
target/

# Worktree-local Java toolchain (JDK 17, Gradle, Gradle user home) resolved
# per dispatch and checksum-verified; never committed. See
# docs/validation/capture-guide.md.
/tools/
# Only the viewer's source helper/tests live alongside ignored local toolchains.
!/tools/
/tools/*
!/tools/prepare_report_assets.py
!/tools/tests/
/tools/tests/*
!/tools/tests/test_prepare_report_assets.py

# Viewer-generated reports and original-art caches never enter source control.
/files/run-viewer/

# Gradle build outputs and project caches (root + subprojects).
validation/windows-mod/.gradle/
validation/windows-mod/build/
validation/windows-mod/*/build/

# External game/loader jars: user-provided paths, always outside the repo.
validation/windows-mod/external/

# Unreviewed reference captures and isolated RNG exports (promoted only
# after review on the pinned game).
validation/captures/
validation/reference_rng/
